# GitHub PAT: repo + admin:repo_hook (or fine-grained equivalent on starintel-labs + lost-rob0t)
FORGE_SYNC_GITHUB_TOKEN=

# Gitea/Forgejo instance base URL (API-compatible /api/v1) and token
# with write:repository, write:issue, write:organization
FORGE_SYNC_FORGEJO_API=
FORGE_SYNC_FORGEJO_TOKEN=

# Webhook HMAC secrets (generate: openssl rand -hex 32)
FORGE_SYNC_GITHUB_WEBHOOK_SECRET=
FORGE_SYNC_FORGEJO_WEBHOOK_SECRET=

# Optional pacing: minimum spacing between API requests to protect quota.
# Leave unset for full speed; e.g. 1500ms keeps you far under 5000 req/h.
FORGE_SYNC_GITHUB_MIN_INTERVAL=
FORGE_SYNC_FORGEJO_MIN_INTERVAL=

# Namespace -> Gitea owner redirect, e.g. lost-rob0t:nsaspy
FORGE_SYNC_FORGEJO_OWNER_MAP=

# Ref sync skips repositories larger than this (MB, default 8192).
FORGE_SYNC_MAX_REF_SIZE_MB=
